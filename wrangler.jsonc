{
    "account_id": "8cab74f5e12309e5c1a9f394dbe41531",
    "compatibility_date": "2025-05-05",
    "compatibility_flags": ["nodejs_compat"],
    "main": "worker/index.ts",
    "name": "infinite-mac",
    "workers_dev": false,
    "cache": {
        "enabled": true,
    },
    "assets": {
        "binding": "ASSETS",
        "directory": "./build",
        "not_found_handling": "single-page-application",
        "run_worker_first": true,
    },
    "r2_buckets": [
        {
            "binding": "DISK_BUCKET",
            "bucket_name": "infinite-mac-disk",
        },
    ],
    "routes": [
        {
            "pattern": "mac.morphing.cloud/*",
            "zone_name": "morphing.cloud",
        },
    ],
    "observability": {
        "enabled": true,
        "head_sampling_rate": 0.1,
    },
}
